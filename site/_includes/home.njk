{% set locale = lang or "en" %}
{% set labels = copy[locale] %}
{% set notes = collections.notes | localizedNotes(locale) %}
<section class="hero" aria-labelledby="intro">
  <div class="hero-copy">
    <p class="eyebrow"><span class="signal"></span> {{ labels.notebook }}</p>
    <h1 id="intro">{{ labels.headline }}</h1>
    <p>{{ labels.intro }}</p>
    <div class="hero-actions">
      <a class="button" href="{{ '/notes/start-here/' | localizedUrl(locale) }}">{{ labels.start }} <span aria-hidden="true">↗</span></a>
      <a href="{{ '/notes/robotics-career-roadmap/' | localizedUrl(locale) }}">{{ labels.careers }}</a>
    </div>
  </div>
  <figure class="diagram">
    <img src="/assets/arm.svg" width="560" height="342" alt="{{ labels.figureAlt }}">
    <figcaption><span>{{ labels.figureNumber }}</span> {{ labels.figureCaption }}</figcaption>
  </figure>
</section>
<section class="library" id="notes" aria-labelledby="library-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ labels.bookIndex }} / {{ notes | length }} {{ labels.chapters | upper }}</p>
      <h2 id="library-title">{{ labels.toc }}</h2>
    </div>
    <p>{{ labels.core }}</p>
  </div>
  <nav class="track-nav" aria-label="{{ labels.parts }}">
    {% for track in tracks %}
    <a href="#{{ track.id }}">{{ chinese.tracks[track.id].title if locale == "zh-CN" else track.title }}</a>
    {% endfor %}
  </nav>
  {% for track in tracks %}
  {% set entry = chinese.tracks[track.id] if locale == "zh-CN" else track %}
  <section class="track" id="{{ track.id }}" aria-labelledby="{{ track.id }}-title">
    <header>
      <p class="eyebrow">{% if locale == "zh-CN" %}第 {{ track.number }} 篇{% else %}{{ labels.part }} {{ track.number }}{% endif %}</p>
      <h3 id="{{ track.id }}-title">{{ entry.title }}</h3>
      <p>{{ entry.outcome }}</p>
    </header>
    <ol class="note-grid">
      {% for note in notes %}
      {% if note.data.topic in track.topics %}
      <li>
        <a class="card" href="{{ note.url }}">
          <span class="card-top"><span class="eyebrow">{{ note.data.order | escape }}{% if note.data.minutes %} / {{ note.data.minutes }} {{ labels.minutes }}{% endif %}</span><span class="card-arrow" aria-hidden="true">↗</span></span>
          <h4>{{ note.data.title | escape }}</h4>
          <p>{{ note.data.description | escape }}</p>
        </a>
      </li>
      {% endif %}
      {% endfor %}
    </ol>
  </section>
  {% endfor %}
</section>
