<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description | escape }}">
  <title>{% if title %}{{ title | escape }} · {% endif %}Robo Study</title>
  <link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top shell">
    <a class="brand" href="/"><img src="/assets/icon.svg" alt="" width="32" height="32"> Robo Study</a>
    <nav aria-label="Main navigation">
      <a href="/#notes">Contents</a>
      <a href="/demos/">Labs</a>
      <a href="https://github.com/sunnyday9/robo-study">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main class="shell" id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  <footer class="footer shell">
    <span>Robo Study · A robotics engineering textbook</span>
    <a href="https://github.com/sunnyday9/robo-study/issues">Suggest a correction <span aria-hidden="true">↗</span></a>
  </footer>
</body>
</html>
